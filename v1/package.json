{
  "name": "music-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Lecture de partitions à partir d'images : reconnaissance (Audiveris), relecture et correction, écoute, impression.",
  "type": "module",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node server/server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "opensheetmusicdisplay": "^2.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
