{
  "name": "music-reader",
  "version": "1.0.0",
  "private": true,
  "description": "Lecture de partitions à partir d'images : reconnaissance (Audiveris), relecture et correction, écoute, impression.",
  "author": "Ghomerr",
  "homepage": "https://github.com/Ghomerr/music-reader",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node server/server.mjs",
    "desktop:resources": "node desktop/fetch-resources.mjs",
    "desktop": "vite build && electron .",
    "desktop:smoke": "electron . --smoke-test=desktop/test/yankee-doodle.png",
    "desktop:pack": "vite build && electron-builder --publish never",
    "desktop:smoke:packaged": "node desktop/smoke-packaged.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "opensheetmusicdisplay": "^2.2.0",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
